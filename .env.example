# Порт сервера
PORT=3000
NODE_ENV=development

# Тип базы данных: 'sqlite' (по умолчанию), 'postgres', 'mysql'
DB_TYPE=sqlite

# Для SQLite: путь к файлу базы данных
DB_FILE=./data/learningj.db

# Для PostgreSQL / MySQL (если переключаетесь):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=learningj
# DATABASE_URL=postgresql://postgres:password@localhost:5432/learningj

